APP_NAME=软件设计师 AI 智能刷题系统
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/software_designer
SQL_ECHO=false
IMPORT_STORAGE_ROOT=var/imports
IMPORT_MAX_FILE_SIZE_MB=50
PDF_RENDER_DPI=200
LIBREOFFICE_PATH=soffice
AI_BASE_URL=
AI_API_KEY=
AI_VISION_MODEL=
AI_CLASSIFICATION_MODEL=
AI_PROVIDER_NAME=openai-compatible
AI_TIMEOUT_SECONDS=120
AI_TEXT_MODEL=
# Primary teaching model defaults to AI_TEXT_MODEL when blank.
AI_TUTOR_MODEL=
H5_ENABLED=true
LEARNING_AI_ENABLED=true

# Teaching models: ordered fallbacks, separate timeout, blank effort uses provider default.
AI_TUTOR_FALLBACK_MODELS=[]
AI_TUTOR_REASONING_EFFORT=low
AI_TUTOR_TIMEOUT_SECONDS=30


# Voice input: ASR -> text LLM. Provider keys stay server-side.
VOICE_ENABLED=true
ASR_PROVIDER=dashscope
ASR_API_KEY=
ASR_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ASR_MODEL=qwen-audio-3.0-asr-flash-filetrans
POLISH_ENABLED=true
POLISH_API_KEY=
POLISH_BASE_URL=https://api.openai.com/v1
POLISH_MODEL=gpt-4.1-mini
# Disable thinking for polishing; the key must match POLISH_BASE_URL.
POLISH_ENABLE_THINKING=false
# DMX Qwen example: keep your DMX key in POLISH_API_KEY.
# POLISH_BASE_URL=https://www.dmxapi.cn/v1
# POLISH_MODEL=qwen3.8-flash
