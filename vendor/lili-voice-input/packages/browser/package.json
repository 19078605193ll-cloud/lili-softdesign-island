{
  "name": "@lili-voice-input/browser",
  "version": "0.1.0",
  "description": "UI-agnostic browser client for lili-voice-input",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./pcm-worklet.js": "./src/pcm-worklet.ts"
  },
  "files": ["src", "README.md"],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && esbuild src/pcm-worklet.ts --bundle --format=iife --outfile=dist/pcm-worklet.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
